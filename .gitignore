# Ignore all .sb3s and .jsons anywhere in the repository
*.sb3
*.json

# Ignore extracted or intermediate target files
extracted_project.json
*.aida

# Standard Rust / Cargo build outputs
/target/
Cargo.lock

# Operating system metadata files
.DS_Store
Thumbs.db

# Keep the VS Code extension's source files and highlighting sample.
!/editors/vscode/**/*.json
!/editors/vscode/examples/*.aida
/editors/vscode/node_modules/
/editors/vscode/*.vsix
