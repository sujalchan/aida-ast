{
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^([^\"\\n]|\"([^\"\\\\]|\\\\.)*\")*[\\{[(]\\s*$",
    "decreaseIndentPattern": "^\\s*[\\}\\])]"
  },
  "wordPattern": "[^\\s.{}()\\[\\]:,=+*/!<>|&\"-]+"
}
